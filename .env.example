# ─── Motor de sondeo (REQUERIDO) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Config eficiente: Haiku 4.5 (probe = detección, no razonamiento) → 5× más barato
# que Opus; el chatbot también en Haiku. 2 búsquedas + respuesta corta = costo mínimo.
CLAUDE_MODEL=claude-haiku-4-5
CHAT_MODEL=claude-haiku-4-5
WEB_SEARCH_MAX_USES=2
PROBE_MAX_TOKENS=512

# ─── Seguridad ───────────────────────────────────────────────────────────────
# Token para disparar sondeos manuales (botón ▶ en el dashboard). Cambialo.
ADMIN_TOKEN=pon-un-token-secreto-aqui

# ─── Login del dashboard ─────────────────────────────────────────────────────
# Usuarios permitidos, formato "user1:pass1,user2:pass2".
AUTH_USERS=ValeMurillo:aeogaia2026,AXIO:aeogaia2026
# Secreto para firmar la cookie de sesión (si se omite, deriva de ADMIN_TOKEN).
# SESSION_SECRET=un-secreto-largo-aleatorio
SESSION_TTL=43200            # 12 h
COOKIE_SECURE=true           # true en prod (HTTPS); false para local (http)

# ─── Cadencia ────────────────────────────────────────────────────────────────
# Scheduler automático APAGADO por defecto → los sondeos solo corren cuando los
# disparás vos (botón ▶ "Correr sondeo ahora" o POST /api/probe/run).
# Poné SCHEDULER_ENABLED=true si querés reactivar el tick diario según PROBE_CRON.
SCHEDULER_ENABLED=false
PROBE_CRON=0 9 * * *   # solo aplica si SCHEDULER_ENABLED=true (UTC)
CAMPAIGN_DAYS=60

# ─── Base de datos ───────────────────────────────────────────────────────────
# Local (SQLite): dejar sin setear o usar la línea de abajo.
# DATABASE_URL=sqlite:///./data/aeo.db
# Railway inyecta DATABASE_URL del plugin Postgres automáticamente.

# ─── Identidad de marca (opcional — ya trae defaults de Gaia) ─────────────────
# BRAND_NAME=Gaia School
# BRAND_DOMAIN=gaiaschoolcr.org
# BRAND_ALIASES=Gaia School,Gaia School Costa Rica,Escuela Gaia,gaiaschoolcr.org

# ─── Otros motores (OPCIONAL — activan sus adapters al setear la key) ─────────
# OPENAI_API_KEY=
# PERPLEXITY_API_KEY=
# GEMINI_API_KEY=
